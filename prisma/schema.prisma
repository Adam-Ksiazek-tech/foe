generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model accounts {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        BigInt?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  users             users   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "accounts_user_id_fkey")

  @@unique([provider, providerAccountId], map: "accounts_provider_provider_account_id_key")
}

model draws {
  id        Int      @id @default(autoincrement())
  draw_date DateTime @unique(map: "draw_date_ukey") @db.Date
  numbers   Int[]
  draw_type String?  @default("lotto")

  @@index([numbers], map: "idx_draws_numbers", type: Gin)
}

model login_events {
  id                  Int      @id @default(autoincrement())
  app                 String
  email               String?
  name                String?
  provider            String
  provider_account_id String?
  created_at          DateTime @default(now()) @db.Timestamptz(6)
}

model sessions {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @unique(map: "sessions_session_token_key")
  userId       String   @db.Uuid
  expires      DateTime @db.Timestamptz(6)
  users        users    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "sessions_user_id_fkey")
}

model user_settings {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  api_source String    @default("lottostats.pl")
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)

  @@index([email], map: "idx_user_settings_email")
}

model users {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String?
  email         String     @unique
  emailVerified DateTime?  @db.Timestamptz(6)
  image         String?
  password_hash String?
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  accounts      accounts[]
  sessions      sessions[]
}

model verification_token {
  identifier String
  token      String
  expires    DateTime @db.Timestamptz(6)

  @@id([identifier, token])
}

model Investment {
  id             Int       @id @default(autoincrement())
  msgId          BigInt    @unique
  conversationId BigInt
  playerId       BigInt
  playerName     String
  text           String
  gameDate       String
  beautyDate     DateTime
  receivedAt     DateTime  @default(now())
  parsedAmount   Int?
  parsedOk       Boolean   @default(false)
  finalAmount    Int?
  verified       Boolean   @default(false)
  verifiedAt     DateTime?
}